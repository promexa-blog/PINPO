# fal.ai API key — read ONLY by the worker process. Never commit .env.local.
FAL_KEY=
# 1 = generate fake clips locally with ffmpeg (no cost, no key needed)
FAL_MOCK=1
# Max fal requests the worker keeps in flight (fal queues the rest)
FAL_MAX_IN_FLIGHT=4

# Extra hostnames allowed to reach the studio besides 127.0.0.1/localhost (comma-separated).
# Only set this if you deliberately serve the studio on your network.
PINPO_ALLOWED_HOSTS=
