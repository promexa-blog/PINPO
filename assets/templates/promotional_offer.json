{
  "key": "promotional_offer",
  "name": "Promotional offer",
  "description": "Lead with the price or discount, show the product, then the offer details and the call to action.",
  "platforms": [
    "instagram_reels",
    "instagram_story",
    "youtube_shorts",
    "instagram_feed",
    "facebook_feed",
    "youtube_instream"
  ],
  "lengths": [
    15,
    30,
    45,
    60
  ],
  "defaultOutro": "promotional",
  "cta": {
    "placement": "final_scene_and_outro"
  },
  "scenes": [
    {
      "role": "offer_hook",
      "label": "Offer hook",
      "weight": 1.1,
      "sceneType": "product_original",
      "showsProduct": true,
      "minLengthS": 15,
      "visualDirection": "Open on the price and the real product.",
      "overlay": {
        "source": "offer",
        "layout": "corner_badge",
        "motion": "scale-in"
      },
      "productMotion": "push-in"
    },
    {
      "role": "hero",
      "label": "Product hero",
      "weight": 1.2,
      "sceneType": "ai_from_product",
      "showsProduct": true,
      "minLengthS": 15,
      "visualDirection": "The product looking its best.",
      "overlay": {
        "source": "claim:0",
        "layout": "lower_third",
        "motion": "fade-up"
      },
      "promptScaffold": "Hero shot of {appearance} on {setting}, slowly revealed. {camera}. {lighting}. {toneMood}."
    },
    {
      "role": "details",
      "label": "Offer details",
      "weight": 1.0,
      "sceneType": "product_original",
      "showsProduct": true,
      "minLengthS": 30,
      "visualDirection": "Offer details and validity, from the brief only.",
      "overlay": {
        "source": "offer",
        "layout": "corner_badge",
        "motion": "fade-up"
      },
      "productMotion": "parallax"
    },
    {
      "role": "benefit",
      "label": "Benefit",
      "weight": 1.0,
      "sceneType": "ai_scene",
      "showsProduct": false,
      "minLengthS": 45,
      "visualDirection": "Why it's worth it.",
      "overlay": {
        "source": "claim:1",
        "layout": "lower_third",
        "motion": "fade-up"
      },
      "promptScaffold": "{audienceWho} enjoying the benefit of a {categoryNoun} in {setting}. {camera}. {lighting}. {toneMood}."
    },
    {
      "role": "cta",
      "label": "Call to action",
      "weight": 1.1,
      "sceneType": "product_original",
      "showsProduct": true,
      "minLengthS": 15,
      "visualDirection": "Product with the call to action.",
      "overlay": {
        "source": "cta",
        "layout": "centered",
        "motion": "scale-in"
      },
      "productMotion": "pan"
    }
  ]
}
