{
  "name": "pinpo",
  "version": "0.1.0",
  "private": true,
  "description": "PINPO — DemandMesh AI ad production studio",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fal-ai/client": "1.10.1",
    "@puppeteer/browsers": "3.2.6",
    "better-sqlite3": "13.0.3",
    "ffmpeg-static": "5.3.0",
    "ffprobe-static": "3.1.0",
    "next": "16.4.5",
    "puppeteer-core": "25.16.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.4",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "concurrently": "10.0.6",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "4.3.4",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "scripts": {
    "setup": "tsx scripts/setup.ts",
    "dev": "concurrently -k -n web,worker -c blue,magenta \"next dev -H 127.0.0.1 -p 3000\" \"tsx watch --clear-screen=false src/worker/index.ts\"",
    "dev:web": "next dev -H 127.0.0.1 -p 3000",
    "worker": "tsx src/worker/index.ts",
    "build": "next build",
    "start": "concurrently -k -n web,worker -c blue,magenta \"next start -H 127.0.0.1 -p 3000\" \"tsx src/worker/index.ts\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "models:check": "tsx scripts/models-check.ts"
  }
}
